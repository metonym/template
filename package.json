{
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "bun run --filter server start",
    "dev": "bun run --parallel --workspaces dev",
    "build": "bun run --parallel --workspaces --if-present build",
    "typecheck": "tsgo",
    "lint": "biome lint .",
    "lint:fix": "biome check --write --unsafe ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.0",
    "@typescript/native-preview": "^7.0.0-dev.20260105.1",
    "lefthook": "^1.13.6"
  }
}
